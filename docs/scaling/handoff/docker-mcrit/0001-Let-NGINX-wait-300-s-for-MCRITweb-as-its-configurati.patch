From 9bf64846ef94c64335aff2e8d657102e8509e874 Mon Sep 17 00:00:00 2001
From: r0ny123 <49360849+r0ny123@users.noreply.github.com>
Date: Thu, 24 Sep 2026 13:07:34 +0000
Subject: [PATCH 1/3] Let NGINX wait 300 s for MCRITweb, as its configuration
 already meant to

Both site files set uwsgi_read_timeout 300s, but MCRITweb is reached with proxy_pass,
and the uwsgi_* directives only apply to uwsgi_pass. proxy_read_timeout therefore stayed
at its 60 s default, and any request MCRITweb needed longer for - a large result page, an
upload being processed, an API passthrough - answered 504 while gunicorn, started with
-t 300, was still working on it.

Reproduced with nginx:1.29-alpine and the repository's own nginx.conf and site file in
front of a stand-in upstream that answers after 90 s: status 504 after 60.0 s before this
change, 200 after 87.7 s with it. nginx -t accepts both site files, the TLS one with a
throwaway certificate.
---
 CHANGELOG.md              | 10 ++++++++++
 nginx/mcritweb_plain.conf |  5 ++++-
 nginx/mcritweb_ssl.conf   |  5 ++++-
 3 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/CHANGELOG.md b/CHANGELOG.md
index d66befd..fb829e6 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -21,6 +21,16 @@ deployment that means saying plainly what an operator has to *do*, which is what
 
 ## [Unreleased]
 
+### Fixed
+
+- **NGINX cut every MCRITweb request off at 60 seconds**, not the 300 its configuration asks for.
+  Both site files set `uwsgi_read_timeout 300s`, but MCRITweb is reached through `proxy_pass`, and
+  the `uwsgi_*` directives only govern `uwsgi_pass`, so `proxy_read_timeout` stayed at its default.
+  A page, upload or passthrough call that took longer answered `504 Gateway Time-out` while gunicorn
+  (`-t 300`) was still working on it. Measured with a stand-in upstream that answers after 90 s: 504
+  at 60.0 s before, 200 at 87.7 s after. Both site files now set `proxy_read_timeout` and
+  `proxy_send_timeout` to 300 s.
+
 ## [2026-09-23] - MCRIT 1.9.0, MCRITweb 1.5.0
 
 MCRITweb 1.5.0: 46 pull requests, four security fixes and the function comparison view,
diff --git a/nginx/mcritweb_plain.conf b/nginx/mcritweb_plain.conf
index dbad4fb..e589a64 100644
--- a/nginx/mcritweb_plain.conf
+++ b/nginx/mcritweb_plain.conf
@@ -5,7 +5,10 @@ server {
 
     client_max_body_size 500M;
     client_body_timeout 300s;
-    uwsgi_read_timeout 300s;
+    # mcritweb sits behind proxy_pass, so these are the timeouts that apply. uwsgi_read_timeout,
+    # which stood here, only governs uwsgi_pass: requests were cut at nginx's default 60s.
+    proxy_read_timeout 300s;
+    proxy_send_timeout 300s;
     charset utf-8;
 
     if ($host != $server_name) {
diff --git a/nginx/mcritweb_ssl.conf b/nginx/mcritweb_ssl.conf
index dddb223..5558136 100644
--- a/nginx/mcritweb_ssl.conf
+++ b/nginx/mcritweb_ssl.conf
@@ -20,7 +20,10 @@ server {
 
     client_max_body_size 500M;
     client_body_timeout 300s;
-    uwsgi_read_timeout 300s;
+    # mcritweb sits behind proxy_pass, so these are the timeouts that apply. uwsgi_read_timeout,
+    # which stood here, only governs uwsgi_pass: requests were cut at nginx's default 60s.
+    proxy_read_timeout 300s;
+    proxy_send_timeout 300s;
     charset utf-8;
 
     if ($host != $server_name) {
